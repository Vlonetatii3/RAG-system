FLASK_ENV=development
FLASK_PORT=5000
# 127.0.0.1 en vez de localhost: en Windows 'localhost' prueba IPv6 primero y añade ~2s por llamada
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:7b sigue mejor la instrucción de no inventar y es más rápido que mistral (ver README)
OLLAMA_MODEL=qwen2.5:7b
EMBEDDINGS_MODEL=nomic-embed-text
# Segundos de espera por respuesta de Ollama (subir si tu equipo es lento)
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m
DATABASE_PATH=./data/rag.db
UPLOADS_PATH=./data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=50
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
